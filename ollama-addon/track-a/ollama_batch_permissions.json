{
  "permissions": {
    "allow": [
      "Bash(*)",
      "PowerShell(*)",
      "Write(*)",
      "Edit(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "mcp__firecrawl__firecrawl_scrape",
      "mcp__firecrawl__firecrawl_search",
      "mcp__firecrawl__firecrawl_map",
      "mcp__exa__web_search_exa",
      "mcp__exa__web_fetch_exa",
      "mcp__gemini__gemini-search",
      "mcp__gemini__gemini-analyze-url",
      "mcp__gemini__gemini-extract-from-url",
      "mcp__gemini__gemini-summarize-pdf",
      "mcp__gemini__gemini-analyze-document",
      "mcp__gemini__gemini-youtube",
      "mcp__gemini__gemini-youtube-summary"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(./.env)",
      "Read(**/.env.*)",
      "Bash(*git*commit*)",
      "Bash(*git*push*)",
      "Bash(*git*merge*)",
      "Bash(*git*rebase*)",
      "Bash(*git*reset --hard*)",
      "Bash(*gh pr create*)",
      "Bash(*gh pr merge*)",
      "Bash(*gh pr close*)",
      "Bash(rm -rf *)",
      "Bash(Remove-Item * -Recurse *)",
      "Write(~/.claude/**)",
      "Edit(~/.claude/**)",
      "Bash(cat *.env*)",
      "Bash(cat *credentials*)",
      "Bash(cat *.pem*)",
      "Bash(cat id_rsa*)",
      "Bash(type *.env*)",
      "Bash(type *credentials*)",
      "Bash(Get-Content *.env*)",
      "Bash(Get-Content *credentials*)",
      "Bash(more *.env*)",
      "Bash(less *.env*)",
      "Bash(findstr *.env*)",
      "Bash(*.env*)",
      "Bash(*id_rsa*)",
      "Bash(*id_ed25519*)",
      "Bash(*.git-credentials*)",
      "Bash(*credentials.json*)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(nc *)",
      "mcp__firecrawl__firecrawl_agent",
      "mcp__firecrawl__firecrawl_agent_status",
      "mcp__firecrawl__firecrawl_check_crawl_status",
      "mcp__firecrawl__firecrawl_crawl",
      "mcp__firecrawl__firecrawl_developer_search",
      "mcp__firecrawl__firecrawl_extract",
      "mcp__firecrawl__firecrawl_feedback",
      "mcp__firecrawl__firecrawl_interact",
      "mcp__firecrawl__firecrawl_interact_stop",
      "mcp__firecrawl__firecrawl_monitor_check",
      "mcp__firecrawl__firecrawl_monitor_checks",
      "mcp__firecrawl__firecrawl_monitor_create",
      "mcp__firecrawl__firecrawl_monitor_delete",
      "mcp__firecrawl__firecrawl_monitor_get",
      "mcp__firecrawl__firecrawl_monitor_list",
      "mcp__firecrawl__firecrawl_monitor_run",
      "mcp__firecrawl__firecrawl_monitor_update",
      "mcp__firecrawl__firecrawl_parse",
      "mcp__firecrawl__firecrawl_research_inspect_paper",
      "mcp__firecrawl__firecrawl_research_read_paper",
      "mcp__firecrawl__firecrawl_research_related_papers",
      "mcp__firecrawl__firecrawl_research_search_github",
      "mcp__firecrawl__firecrawl_research_search_papers",
      "mcp__firecrawl__firecrawl_search_feedback",
      "mcp__firecrawl__firecrawl_batch_scrape",
      "mcp__gemini__gemini-deep-research",
      "Edit(**/ollama_batch_permissions.json)",
      "Write(**/ollama_batch_permissions.json)",
      "Bash(*api.firecrawl.dev*)",
      "PowerShell(*api.firecrawl.dev*)",
      "PowerShell(*git*commit*)",
      "PowerShell(*git*push*)",
      "PowerShell(*git*merge*)",
      "PowerShell(*git*rebase*)",
      "PowerShell(*git*reset --hard*)",
      "PowerShell(*gh pr create*)",
      "PowerShell(*gh pr merge*)",
      "PowerShell(*gh pr close*)",
      "PowerShell(rm -rf *)",
      "PowerShell(Remove-Item * -Recurse *)",
      "PowerShell(cat *.env*)",
      "PowerShell(cat *credentials*)",
      "PowerShell(cat *.pem*)",
      "PowerShell(cat id_rsa*)",
      "PowerShell(type *.env*)",
      "PowerShell(type *credentials*)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(Get-Content *credentials*)",
      "PowerShell(more *.env*)",
      "PowerShell(less *.env*)",
      "PowerShell(findstr *.env*)",
      "PowerShell(*.env*)",
      "PowerShell(*id_rsa*)",
      "PowerShell(*id_ed25519*)",
      "PowerShell(*.git-credentials*)",
      "PowerShell(*credentials.json*)",
      "PowerShell(ssh *)",
      "PowerShell(scp *)",
      "PowerShell(nc *)",
      "Bash(*.claude*)",
      "PowerShell(*.claude*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__(firecrawl|gemini)__.*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$USERPROFILE/.claude/hooks/firecrawl_budget_gate.ps1\"",
            "shell": "bash",
            "timeout": 15,
            "statusMessage": "Checking research budget"
          }
        ]
      }
    ]
  }
}
